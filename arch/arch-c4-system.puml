@startuml
!include templates/plantuml-theme.puml

scale 2/3
'left to right direction
center header
    C4 Architecture: System Diagram Header
endheader

title Church Bulletin System Diagram <&circle-check>
'
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/release/1-0/C4_Context.puml

'LAYOUT_WITH_LEGEND

Person(requestor, "Requestor", "Church staff who create work orders")
Person(supervisor, "Supervisor", "Assigns, reassigns, and cancels work orders")
Person(assignee, "Assignee", "Facilities team member fulfilling work orders")

System(churchbulletin, "Church Bulletin Work Order System", "Creates, assigns, tracks, and completes work orders")

System_Ext(azureOpenAI, "Azure OpenAI", "LLM for AI agent features")
System_Ext(sqlServer, "SQL Server / Azure SQL", "Primary relational database")
System_Ext(nsb, "NServiceBus SQL Transport", "Asynchronous message transport and saga persistence")
System_Ext(appInsights, "Application Insights", "Optional telemetry backend")

Rel(requestor, churchbulletin, "Create and track work orders")
Rel(supervisor, churchbulletin, "Assign, reassign, or cancel work orders")
Rel(assignee, churchbulletin, "Start, shelve, and complete work orders")

Rel(churchbulletin, sqlServer, "Reads/writes domain data", "EF Core / TCP")
Rel(churchbulletin, nsb, "Publishes and handles async events", "NServiceBus")
Rel(churchbulletin, azureOpenAI, "Calls LLM for AI-assisted features", "HTTPS")
Rel(churchbulletin, appInsights, "Exports traces/metrics/logs", "OpenTelemetry / HTTPS")

LEGEND("Legend","Actors: Requestor, Supervisor, Assignee\nSystem: Work order lifecycle management\nDB: SQL Server / Azure SQL\nNSB: NServiceBus SQL transport\nOTEL: OpenTelemetry to optional Application Insights\nLLM: Azure OpenAI")
FOOTER()
@enduml