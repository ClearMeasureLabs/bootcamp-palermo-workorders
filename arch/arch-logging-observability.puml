@startuml
!include templates/plantuml-theme.puml

scale 2/3
left to right direction
center header
    Architecture: Logging & Observability
endheader

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/release/1-0/C4_Container.puml

title Logging & Observability

Person(ops, "Operator / SRE", "Monitors health, traces, and logs")

System_Boundary(system, "Church Bulletin (deployed)") {
    Container(ui, "Blazor WASM Client", "Browser", "Calls API endpoints")
    Container(server, "UI.Server", "ASP.NET", "Structured JSON logs + OpenTelemetry exporters")
    Container(worker, "Worker", ".NET Worker", "Structured JSON logs + OpenTelemetry exporters")
    Container(mcp, "McpServer (standalone optional)", "ASP.NET", "Structured JSON logs by default")
}

System_Ext(appInsights, "Azure Monitor / Application Insights", "Optional telemetry backend")
System_Ext(otlpBackend, "OTLP backend (optional)", "Optional collector/gateway/backend")
System_Ext(logSink, "Container/App platform logs", "JSON log aggregation sink")

Rel(ui, server, "API calls (trace context propagation)", "HTTPS")

Rel(server, appInsights, "Direct export (optional)", "Azure Monitor exporter / HTTPS")
Rel(worker, appInsights, "Direct export (optional)", "Azure Monitor exporter / HTTPS")
Rel(server, otlpBackend, "Direct export (optional)", "OTLP")
Rel(worker, otlpBackend, "Direct export (optional)", "OTLP")
Rel(mcp, logSink, "Writes structured JSON logs", "stdout/stderr")
Rel(server, logSink, "Writes structured JSON logs", "stdout/stderr")
Rel(worker, logSink, "Writes structured JSON logs", "stdout/stderr")

Rel(ops, appInsights, "Dashboards, traces, metrics, alerts")
Rel(ops, logSink, "Container log search")

note right of mcp
Standalone McpServer is logs-first.
Telemetry export is optional and only present
when OpenTelemetry/exporters are configured.
end note

LEGEND("Legend","No mandatory OpenTelemetry Collector is assumed\nServer/Worker use direct exporters to Azure Monitor and/or OTLP backends when configured\nMcpServer always emits structured JSON logs; exporter wiring is optional\nSplunk is not part of default architecture")
FOOTER()
@enduml
