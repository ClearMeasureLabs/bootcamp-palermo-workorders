@startuml
!include templates/plantuml-theme.puml

scale 2/3
left to right direction
center header
    C4 Architecture: Container Diagram Header
endheader

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/release/1-0/C4_Container.puml

title Container diagram (IFPUG Function Points per deployed process)

Person(user, "Church Staff", "Pastor, volunteer, or leader")

System_Boundary(system, "Church Bulletin") {
    Container(ui, "Blazor WASM Client", "Blazor WebAssembly", "Interactive browser application\n== 6 FP ==")
    Container(server, "UI Server", "ASP.NET / Azure Container App", "Hosts API, Blazor Server, MCP endpoint\n== 98 FP ==")
    Container(worker, "Worker", ".NET Worker Service", "NServiceBus endpoint for async processing\n== 27 FP ==")
    Container(mcpServer, "MCP Server", "ASP.NET", "Model Context Protocol tools for AI agents\n== 37 FP ==")
    ContainerDb(db, "Database", "Azure SQL Server", "Work orders, employees, roles\n== 28 FP ==")
    ContainerDb(nsbTransport, "NServiceBus Transport", "SQL Server", "Message queues and saga persistence\n== 0 FP ==")
}

System_Ext(azureOpenAI, "Azure OpenAI", "LLM for AI agent features")
System_Ext(acr, "Azure Container Registry", "Docker image repository")
System_Ext(telemetry, "Application Insights / OpenTelemetry", "Tracing, metrics, and logs")
System_Ext(octopus, "Octopus Deploy", "Release / deployment orchestration (or CI pipeline)")

Rel(user, ui, "Uses", "HTTPS")
Rel(ui, server, "Calls API", "HTTPS")
Rel(server, db, "Reads/writes", "EF Core / TCP")
Rel(server, nsbTransport, "Sends messages", "NServiceBus")
Rel(worker, nsbTransport, "Processes messages", "NServiceBus")
Rel(worker, db, "Reads/writes", "EF Core / TCP")
Rel(server, mcpServer, "Hosts at /mcp", "HTTP")
Rel(server, azureOpenAI, "LLM calls", "HTTPS")
Rel(worker, azureOpenAI, "LLM calls", "HTTPS")
Rel(server, telemetry, "Sends traces/metrics/logs", "OpenTelemetry / HTTPS")
Rel(worker, telemetry, "Sends traces/metrics/logs", "OpenTelemetry / HTTPS")
Rel(mcpServer, telemetry, "Sends traces/metrics/logs", "OpenTelemetry / HTTPS")
Rel(acr, server, "Deploys image", "Docker")
Rel(octopus, acr, "Publishes / manages artifacts", "AZ CLI / Octopus")

LEGEND("Function Point Count (IFPUG)","UI Server (Blazor Server + API + AI gateway): 98 FP\nMCP Server (AI-agent tools + resources): 37 FP\nWorker (.NET / NServiceBus AI-bot saga): 27 FP\nDatabase (Azure SQL - 4 ILFs): 28 FP\nBlazor WASM Client (client-only pages): 6 FP\nNServiceBus Transport (technical store): 0 FP\n----\nDATA functions: 35 FP (5 ILF, 0 EIF)\nTRANSACTIONAL functions: 161 FP (15 EI, 22 EQ, 6 EO)\n====\nTOTAL UNADJUSTED FP (UFP): 196\nMethod: IFPUG CPM 4.3.1 / Capers Jones, apportioned per deployed process")
FOOTER()
@enduml