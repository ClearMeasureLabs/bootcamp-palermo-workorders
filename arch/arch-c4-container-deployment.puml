@startuml
!include templates/plantuml-theme.puml

scale 2/3
left to right direction
center header
    C4 Architecture: Container Diagram Header
endheader

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/release/1-0/C4_Container.puml

title Container diagram 

Person(user, "Church Staff", "Pastor, volunteer, or leader")

System_Boundary(system, "Church Bulletin") {
    Container(uiClient, "UI.Client (Blazor WASM)", "Blazor WebAssembly", "Browser app served by UI.Server by default")
    Container(server, "UI.Server", "ASP.NET / Azure Container App", "Hosts APIs, static UI.Client files, and in-process MCP endpoint")
    Container(mcpEndpoint, "MCP Endpoint (/mcp)", "ModelContextProtocol.AspNetCore", "Default in-process MCP transport hosted by UI.Server")
    Container(mcpServer, "McpServer (optional standalone)", "ASP.NET", "Optional standalone MCP host mode")
    Container(worker, "Worker", ".NET Worker Service", "NServiceBus endpoint for async processing")
    ContainerDb(db, "Database", "Azure SQL Server", "Work orders, employees, roles")
    ContainerDb(nsbTransport, "NServiceBus Transport", "SQL Server", "Message queues and saga persistence")
}

System_Ext(azureOpenAI, "Azure OpenAI", "LLM for AI agent features")
System_Ext(acr, "Azure Container Registry", "Docker image repository")
System_Ext(telemetry, "Application Insights / OpenTelemetry", "Tracing, metrics, and logs")
System_Ext(octopus, "Octopus Deploy", "Release / deployment orchestration (or CI pipeline)")

Rel(user, uiClient, "Uses in browser", "HTTPS")
Rel(uiClient, server, "Calls APIs", "HTTPS")
Rel(server, uiClient, "Serves WASM and static assets", "HTTPS")
Rel(server, db, "Reads/writes", "EF Core / TCP")
Rel(server, nsbTransport, "Sends messages", "NServiceBus")
Rel(worker, nsbTransport, "Processes messages", "NServiceBus")
Rel(worker, db, "Reads/writes", "EF Core / TCP")
Rel(server, mcpEndpoint, "Hosts /mcp in-process", "HTTP")
Rel(mcpServer, db, "Reads/writes (standalone mode)", "EF Core / TCP")
Rel(mcpServer, nsbTransport, "Uses messaging when configured", "NServiceBus")
Rel(server, azureOpenAI, "LLM calls", "HTTPS")
Rel(worker, azureOpenAI, "LLM calls", "HTTPS")
Rel(server, telemetry, "Sends traces/metrics/logs", "OpenTelemetry / HTTPS")
Rel(worker, telemetry, "Sends traces/metrics/logs", "OpenTelemetry / HTTPS")
Rel(mcpServer, telemetry, "Sends traces/metrics/logs", "OpenTelemetry / HTTPS")
Rel(acr, server, "Deploys image", "Docker")
Rel(octopus, acr, "Publishes / manages artifacts", "AZ CLI / Octopus")

LEGEND("Legend","Default mode: UI.Client is served by UI.Server; MCP runs in-process at /mcp\nOptional mode: McpServer can run standalone\nWorker: async processing via NServiceBus SQL transport\nDB: Azure SQL / SQL Server\nOTEL: Application Insights / OpenTelemetry")
FOOTER()
@enduml