@startuml
!include templates/plantuml-theme.puml

scale 2/3
center header
    C4 Architecture: Work Request System — Domain Model
endheader

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/release/1-0/C4_Component.puml

title Work Request System domain model — core domain

abstract class EntityBase<T> {
  +Id : Guid
  +Equals(other : T) : bool
  +Equals(obj : object) : bool
  +ToString() : string
  +GetHashCode() : int
}

class WorkRequest {
  +Title : string
  +Description : string
  +RoomNumber : string
  +Status : WorkRequestStatus
  +Creator : Employee
  +Assignee : Employee
  +Number : string
  +FriendlyStatus : string
  +AssignedDate : DateTime?
  +CreatedDate : DateTime?
  +CompletedDate : DateTime?
  +ChangeStatus(status : WorkRequestStatus) : void
  +ChangeStatus(employee : Employee, date : DateTime, status : WorkRequestStatus) : void
  +GetMessage() : string
  +CanReassign() : bool
}

class Employee {
  +UserName : string
  +FirstName : string
  +LastName : string
  +EmailAddress : string
  +Roles : ISet<Role>
  +CompareTo(other : Employee) : int
  +GetFullName() : string
  +CanCreateWorkRequest() : bool
  +CanFulfillWorkRequest() : bool
  +AddRole(role : Role) : void
  +GetNotificationEmail(day : DayOfWeek) : string
}

class WorkRequestStatus {
  +Code : string
  +Key : string
  +FriendlyName : string
  +SortBy : byte
  {static} +None : WorkRequestStatus
  {static} +Draft : WorkRequestStatus
  {static} +Assigned : WorkRequestStatus
  {static} +InProgress : WorkRequestStatus
  {static} +Complete : WorkRequestStatus
  {static} +GetAllItems() : WorkRequestStatus[]
  +Equals(obj : object) : bool
  +ToString() : string
  +GetHashCode() : int
  +IsEmpty() : bool
  {static} +FromCode(code : string) : WorkRequestStatus
  {static} +FromKey(key : string) : WorkRequestStatus
  {static} +Parse(name : string) : WorkRequestStatus
}

class Role {
  +Name : string
  +CanCreateWorkRequest : bool
  +CanFulfillWorkRequest : bool
}

' Inheritance relationships
WorkRequest --|> EntityBase
Employee --|> EntityBase
Role --|> EntityBase

' Associations
WorkRequest "1" *-- "1" WorkRequestStatus : status
WorkRequest "1" --> "0..1" Employee : creator
WorkRequest "1" --> "0..1" Employee : assignee
Employee "1" *-- "0..*" Role : roles

LEGEND("Legend","WorkRequest: aggregate root\nEmployee: actor\nRole: permissions\nWorkRequestStatus: enumeration class")
FOOTER()
@enduml
