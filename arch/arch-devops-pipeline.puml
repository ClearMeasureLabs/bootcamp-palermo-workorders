@startuml
!include templates/plantuml-theme.puml
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/release/1-0/C4_Component.puml

title Church Bulletin DevOps Pipeline

Person(dev, "Developer", "Pushes feature branches and opens pull requests")

System_Boundary(local, "Local validation") {
    Component(privateBuild, "privatebuild.ps1", "PowerShell", "Compile + unit/integration tests")
    Component(localAcceptance, "acceptancetests.ps1", "PowerShell + Playwright", "Runs acceptance suite separately")
}

System_Boundary(buildWorkflow, "GitHub Actions: Build (build.yml)") {
    Component(buildLinux, "build-linux", "Integration Build (SQL container)", "Primary CI build + package artifacts")
    Component(buildSqlite, "build-sqlite", "Integration Build (SQLite)", "Parallel CI validation")
    Component(buildArm, "integration-build-arm", "Integration Build (ARM SQLite)", "Parallel ARM validation")
    Component(buildWindows, "build-windows", "Integration Build (Windows LocalDB)", "Parallel Windows validation")
    Component(codeAnalysis, "code-analysis", "dotnet format + build", "Style/analyzer gate")
    Component(acceptanceX64, "acceptance-tests", "Playwright", "Separate job from private build")
    Component(acceptanceArm, "acceptance-tests-arm", "Playwright (ARM SQLite)", "Separate ARM acceptance job")
    Component(securityScan, "security-scan", "Disabled job", "Defined but disabled via if: false")
    Component(dockerPublish, "docker-build-image-for-churchbulletin-ui", "Docker + ACR", "Build/push churchbulletin.ui:{version}, latest")
    Component(githubPackages, "publish-github-packages", "NuGet", "Publishes nupkg artifacts")
    Component(octopusPackages, "publish-octopus", "Octopus CLI", "Publishes packages to Octopus feed")
}

System_Boundary(deployWorkflow, "GitHub Actions: Deploy (deploy.yml)") {
    Component(tdd, "deploy-to-tdd", "Octopus + health + Playwright", "Create release, deploy TDD, run post-deploy acceptance tests")
    Component(uat, "deploy-to-uat", "Octopus", "Manual/environment-gated promotion")
    Component(prod, "deploy-to-prod", "Octopus", "Manual/environment-gated promotion")
}

System_Ext(acr, "churchbulletingithubacr", "Azure Container Registry")
System_Ext(octopus, "Octopus Deploy", "Release orchestration")

Rel(dev, privateBuild, "Runs before push")
Rel(dev, localAcceptance, "Runs separately before PR readiness")
Rel(dev, buildWorkflow, "git push / pull request")

Rel(buildLinux, dockerPublish, "needs: build-linux")
Rel(buildLinux, githubPackages, "needs: build-linux")
Rel(buildLinux, octopusPackages, "needs: build-linux")

Rel(dockerPublish, acr, "Push churchbulletin.ui:{BUILD_BUILDNUMBER} and :latest")
Rel(octopusPackages, octopus, "Push nupkg artifacts")

Rel(buildWorkflow, deployWorkflow, "workflow_run on Build success (master)")
Rel(tdd, octopus, "Create/deploy release")
Rel(tdd, uat, "needs success (or manual release dispatch)")
Rel(uat, prod, "needs success")

LEGEND("Legend","Build workflow fans out into parallel integration/analysis/acceptance jobs\nSecurity Scan job exists but is currently disabled (if: false)\nAcceptance tests are separate jobs, not part of private build jobs\nDocker publish job name: docker-build-image-for-churchbulletin-ui\nImage naming: churchbulletingithubacr.azurecr.io/churchbulletin.ui:{version} and :latest")
FOOTER()
@enduml
