// Runbook `rotate-sql-passwords` of project `workorders-infrastructure` (platform-design §7.2, §5.2, §7.8).
// Environments: infra-nonprod (tdd, uat), infra-prod (prod). Monthly scheduled trigger: octopus/terraform
// (projects.tf); triggers run config-as-code runbooks from the default branch
// (https://octopus.com/docs/runbooks/config-as-code-runbooks).
// Order per user: new password -> ALTER USER -> Key Vault -> verify. If the Key Vault write fails, the user is set
// back to the previous password, so SQL and Key Vault never disagree. Deployments read the secret at deploy time
// (read-deployment-secrets), so no restart is needed; the application itself is passwordless (ADR-D9).
// Users: workorders_migrator everywhere; workorders_acceptance in TDD only. Both are removed after WI-05.
// Human procedure: docs/runbooks/credential-rotation.md (sre-security package).
//
// File layout confirmed (https://octopus.com/docs/runbooks/config-as-code-runbooks). Runbook-level environment
// scope has no documented OCL attribute [VERIFY in an export]; action-level environments enforce it.
// sqlcmd authentication method ActiveDirectoryAzCli (go-sqlcmd) [VERIFY]. Passwords never appear in process
// arguments: SQL and secret values go through mode-600 files; the login check uses SQLCMDPASSWORD.

name = "rotate-sql-passwords"
description = "Rotates the interim SQL passwords (workorders_migrator; workorders_acceptance in TDD) and stores them in Key Vault."
default_guided_failure_mode = "EnvironmentDefault"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    step "rotate-tdd" {
        name = "Rotate SQL passwords (tdd)"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "k8s-tdd"
            environments = ["infra-nonprod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu
                    app_env="tdd"
                    if [ "#{Octopus.Environment.Name}" = "infra-prod" ] && [ "#{Octopus.RunbookRun.Git.Ref}" != "refs/heads/main" ]; then
                        fail_step "infra-prod runs only from refs/heads/main (this run: '#{Octopus.RunbookRun.Git.Ref}')."
                    fi
                    rg="rg-workorders-$app_env"
                    server_fqdn="$(az sql server list --resource-group "$rg" --query "[].fullyQualifiedDomainName" --output tsv)"
                    [ "$(printf '%s\n' "$server_fqdn" | grep -c .)" = "1" ] || fail_step "Expected exactly one SQL server in $rg."
                    server_name="$(printf '%s' "$server_fqdn" | cut -d. -f1)"
                    database="$(az sql db list --resource-group "$rg" --server "$server_name" --query "[?name!='master'].name" --output tsv | grep -v -E -- '-(pre|bak|pitr|replaced)-' || true)"
                    [ "$(printf '%s\n' "$database" | grep -c .)" = "1" ] || fail_step "Expected exactly one application database on $server_name."
                    vault="$(az keyvault list --resource-group "$rg" --query "[].name" --output tsv)"
                    [ "$(printf '%s\n' "$vault" | grep -c .)" = "1" ] || fail_step "Expected exactly one Key Vault in $rg."
                    
                    work_dir="$(mktemp -d)"
                    chmod 700 "$work_dir"
                    trap 'rm -rf "$work_dir"' EXIT
                    sql_escape() { printf '%s' "$1" | sed "s/'/''/g"; }
                    run_sql() {
                        printf '%s\n' "$1" > "$work_dir/statement.sql"
                        sqlcmd -S "tcp:$server_fqdn,1433" -d "$database" --authentication-method ActiveDirectoryAzCli -b -i "$work_dir/statement.sql" || return 1
                        rm -f "$work_dir/statement.sql"
                    }
                    kv_set() {
                        printf '%s' "$2" > "$work_dir/secret.txt"
                        az keyvault secret set --vault-name "$vault" --name "$1" --file "$work_dir/secret.txt" --encoding utf-8 --output none || return 1
                        rm -f "$work_dir/secret.txt"
                    }
                    # 32 random base64 characters without symbols, plus a fixed suffix that guarantees the SQL complexity classes.
                    new_password() { printf '%s-9aZ' "$(head -c 48 /dev/urandom | base64 | tr -d '\n/+=' | cut -c1-32)"; }
                    
                    rotate() {
                        user="$1"
                        secret_name="$2"
                        old="$(az keyvault secret show --vault-name "$vault" --name "$secret_name" --query value --output tsv)"
                        new="$(new_password)"
                        run_sql "ALTER USER [$user] WITH PASSWORD = N'$(sql_escape "$new")';"
                        if ! kv_set "$secret_name" "$new"; then
                            run_sql "ALTER USER [$user] WITH PASSWORD = N'$(sql_escape "$old")';"
                            fail_step "Key Vault write failed for $secret_name; $user was set back to the previous password."
                        fi
                        printf 'SELECT 1;\n' > "$work_dir/verify.sql"
                        SQLCMDPASSWORD="$new" sqlcmd -S "tcp:$server_fqdn,1433" -d "$database" -U "$user" -b -i "$work_dir/verify.sql" > /dev/null \
                            || fail_step "Login check failed for $user after rotation; $secret_name holds the new password."
                        echo "Rotated $user; $secret_name updated in $vault."
                    }
                    
                    rotate workorders_migrator workorders-sql-migrator-password
                    if [ "$app_env" = "tdd" ]; then
                        rotate workorders_acceptance workorders-sql-acceptance-password
                    fi
                    write_highlight "SQL passwords rotated for $app_env ($database on $server_name)."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "acr-workorders"
                image = "#{StepImage.CiDotnet}"
            }
        }
    }

    step "rotate-uat" {
        name = "Rotate SQL passwords (uat)"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "k8s-uat"
            environments = ["infra-nonprod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu
                    app_env="uat"
                    if [ "#{Octopus.Environment.Name}" = "infra-prod" ] && [ "#{Octopus.RunbookRun.Git.Ref}" != "refs/heads/main" ]; then
                        fail_step "infra-prod runs only from refs/heads/main (this run: '#{Octopus.RunbookRun.Git.Ref}')."
                    fi
                    rg="rg-workorders-$app_env"
                    server_fqdn="$(az sql server list --resource-group "$rg" --query "[].fullyQualifiedDomainName" --output tsv)"
                    [ "$(printf '%s\n' "$server_fqdn" | grep -c .)" = "1" ] || fail_step "Expected exactly one SQL server in $rg."
                    server_name="$(printf '%s' "$server_fqdn" | cut -d. -f1)"
                    database="$(az sql db list --resource-group "$rg" --server "$server_name" --query "[?name!='master'].name" --output tsv | grep -v -E -- '-(pre|bak|pitr|replaced)-' || true)"
                    [ "$(printf '%s\n' "$database" | grep -c .)" = "1" ] || fail_step "Expected exactly one application database on $server_name."
                    vault="$(az keyvault list --resource-group "$rg" --query "[].name" --output tsv)"
                    [ "$(printf '%s\n' "$vault" | grep -c .)" = "1" ] || fail_step "Expected exactly one Key Vault in $rg."
                    
                    work_dir="$(mktemp -d)"
                    chmod 700 "$work_dir"
                    trap 'rm -rf "$work_dir"' EXIT
                    sql_escape() { printf '%s' "$1" | sed "s/'/''/g"; }
                    run_sql() {
                        printf '%s\n' "$1" > "$work_dir/statement.sql"
                        sqlcmd -S "tcp:$server_fqdn,1433" -d "$database" --authentication-method ActiveDirectoryAzCli -b -i "$work_dir/statement.sql" || return 1
                        rm -f "$work_dir/statement.sql"
                    }
                    kv_set() {
                        printf '%s' "$2" > "$work_dir/secret.txt"
                        az keyvault secret set --vault-name "$vault" --name "$1" --file "$work_dir/secret.txt" --encoding utf-8 --output none || return 1
                        rm -f "$work_dir/secret.txt"
                    }
                    # 32 random base64 characters without symbols, plus a fixed suffix that guarantees the SQL complexity classes.
                    new_password() { printf '%s-9aZ' "$(head -c 48 /dev/urandom | base64 | tr -d '\n/+=' | cut -c1-32)"; }
                    
                    rotate() {
                        user="$1"
                        secret_name="$2"
                        old="$(az keyvault secret show --vault-name "$vault" --name "$secret_name" --query value --output tsv)"
                        new="$(new_password)"
                        run_sql "ALTER USER [$user] WITH PASSWORD = N'$(sql_escape "$new")';"
                        if ! kv_set "$secret_name" "$new"; then
                            run_sql "ALTER USER [$user] WITH PASSWORD = N'$(sql_escape "$old")';"
                            fail_step "Key Vault write failed for $secret_name; $user was set back to the previous password."
                        fi
                        printf 'SELECT 1;\n' > "$work_dir/verify.sql"
                        SQLCMDPASSWORD="$new" sqlcmd -S "tcp:$server_fqdn,1433" -d "$database" -U "$user" -b -i "$work_dir/verify.sql" > /dev/null \
                            || fail_step "Login check failed for $user after rotation; $secret_name holds the new password."
                        echo "Rotated $user; $secret_name updated in $vault."
                    }
                    
                    rotate workorders_migrator workorders-sql-migrator-password
                    if [ "$app_env" = "tdd" ]; then
                        rotate workorders_acceptance workorders-sql-acceptance-password
                    fi
                    write_highlight "SQL passwords rotated for $app_env ($database on $server_name)."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "acr-workorders"
                image = "#{StepImage.CiDotnet}"
            }
        }
    }

    step "rotate-prod" {
        name = "Rotate SQL passwords (prod)"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "k8s-prod"
            environments = ["infra-prod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu
                    app_env="prod"
                    if [ "#{Octopus.Environment.Name}" = "infra-prod" ] && [ "#{Octopus.RunbookRun.Git.Ref}" != "refs/heads/main" ]; then
                        fail_step "infra-prod runs only from refs/heads/main (this run: '#{Octopus.RunbookRun.Git.Ref}')."
                    fi
                    rg="rg-workorders-$app_env"
                    server_fqdn="$(az sql server list --resource-group "$rg" --query "[].fullyQualifiedDomainName" --output tsv)"
                    [ "$(printf '%s\n' "$server_fqdn" | grep -c .)" = "1" ] || fail_step "Expected exactly one SQL server in $rg."
                    server_name="$(printf '%s' "$server_fqdn" | cut -d. -f1)"
                    database="$(az sql db list --resource-group "$rg" --server "$server_name" --query "[?name!='master'].name" --output tsv | grep -v -E -- '-(pre|bak|pitr|replaced)-' || true)"
                    [ "$(printf '%s\n' "$database" | grep -c .)" = "1" ] || fail_step "Expected exactly one application database on $server_name."
                    vault="$(az keyvault list --resource-group "$rg" --query "[].name" --output tsv)"
                    [ "$(printf '%s\n' "$vault" | grep -c .)" = "1" ] || fail_step "Expected exactly one Key Vault in $rg."
                    
                    work_dir="$(mktemp -d)"
                    chmod 700 "$work_dir"
                    trap 'rm -rf "$work_dir"' EXIT
                    sql_escape() { printf '%s' "$1" | sed "s/'/''/g"; }
                    run_sql() {
                        printf '%s\n' "$1" > "$work_dir/statement.sql"
                        sqlcmd -S "tcp:$server_fqdn,1433" -d "$database" --authentication-method ActiveDirectoryAzCli -b -i "$work_dir/statement.sql" || return 1
                        rm -f "$work_dir/statement.sql"
                    }
                    kv_set() {
                        printf '%s' "$2" > "$work_dir/secret.txt"
                        az keyvault secret set --vault-name "$vault" --name "$1" --file "$work_dir/secret.txt" --encoding utf-8 --output none || return 1
                        rm -f "$work_dir/secret.txt"
                    }
                    # 32 random base64 characters without symbols, plus a fixed suffix that guarantees the SQL complexity classes.
                    new_password() { printf '%s-9aZ' "$(head -c 48 /dev/urandom | base64 | tr -d '\n/+=' | cut -c1-32)"; }
                    
                    rotate() {
                        user="$1"
                        secret_name="$2"
                        old="$(az keyvault secret show --vault-name "$vault" --name "$secret_name" --query value --output tsv)"
                        new="$(new_password)"
                        run_sql "ALTER USER [$user] WITH PASSWORD = N'$(sql_escape "$new")';"
                        if ! kv_set "$secret_name" "$new"; then
                            run_sql "ALTER USER [$user] WITH PASSWORD = N'$(sql_escape "$old")';"
                            fail_step "Key Vault write failed for $secret_name; $user was set back to the previous password."
                        fi
                        printf 'SELECT 1;\n' > "$work_dir/verify.sql"
                        SQLCMDPASSWORD="$new" sqlcmd -S "tcp:$server_fqdn,1433" -d "$database" -U "$user" -b -i "$work_dir/verify.sql" > /dev/null \
                            || fail_step "Login check failed for $user after rotation; $secret_name holds the new password."
                        echo "Rotated $user; $secret_name updated in $vault."
                    }
                    
                    rotate workorders_migrator workorders-sql-migrator-password
                    if [ "$app_env" = "tdd" ]; then
                        rotate workorders_acceptance workorders-sql-acceptance-password
                    fi
                    write_highlight "SQL passwords rotated for $app_env ($database on $server_name)."
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "acr-workorders"
                image = "#{StepImage.CiDotnet}"
            }
        }
    }
}
