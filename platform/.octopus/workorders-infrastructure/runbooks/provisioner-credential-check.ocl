// Runbook `provisioner-credential-check` of project `workorders-infrastructure` (platform-design §7.2, ADR-C10, R4).
// Environment: infra-nonprod. Daily scheduled trigger: octopus/terraform (projects.tf).
// - `az login` smoke: the Azure script step signs in with Azure.LifecycleAccount before the script runs, so a
//   revoked or expired client secret fails the step; the script then reads the signed-in context.
// - Warns 14 days before Provisioner.SecretExpiresOn and fails once the date has passed or is not a valid date.
// - At the phase-2 exit Azure.LifecycleAccount switches to azure-oidc-env-lifecycle-nonprod; this runbook and its
//   trigger are then retired together with the secret (R4).
//
// File layout confirmed (https://octopus.com/docs/runbooks/config-as-code-runbooks). Runbook-level environment
// scope has no documented OCL attribute [VERIFY in an export]; action-level environments enforce it.
// The worker-tools container needs a Docker feed that §7.2 does not name: <docker-hub-feed> [CONTRACT GAP].

name = "provisioner-credential-check"
description = "Daily sign-in smoke for Azure.LifecycleAccount in infra-nonprod; warns 14 days before the stored secret expires."
default_guided_failure_mode = "Off"
multi_tenancy_mode = "Untenanted"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Count"
    quantity_to_keep = 30
}

process {
    step "check-provisioner-credential" {
        name = "Check provisioner credential"

        action {
            action_type = "Octopus.AzurePowerShell"
            is_required = true
            worker_pool = "hosted-ubuntu"
            environments = ["infra-nonprod"]
            properties = {
                Octopus.Action.Azure.AccountId = "#{Azure.LifecycleAccount}"
                Octopus.Action.Script.ScriptBody = <<-EOT
                    set -eu
                    account_type="$(az account show --query user.type --output tsv)"
                    subscription="$(az account show --query name --output tsv)"
                    echo "az login smoke passed: principal type $account_type, subscription $subscription."
                    expires="#{Provisioner.SecretExpiresOn}"
                    case "$expires" in
                        [0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]) ;;
                        *) fail_step "Provisioner.SecretExpiresOn must be a date (YYYY-MM-DD); got '$expires'." ;;
                    esac
                    expires_epoch="$(date -u -d "$expires" +%s)" || fail_step "Provisioner.SecretExpiresOn '$expires' is not a valid date."
                    days_left=$(( (expires_epoch - $(date -u +%s)) / 86400 ))
                    if [ "$days_left" -lt 0 ]; then
                        fail_step "The Azure Runtime Provisioner client secret expired on $expires. Rotate it or finish the OIDC switch (ADR-C10)."
                    fi
                    if [ "$days_left" -le 14 ]; then
                        write_warning "The Azure Runtime Provisioner client secret expires in $days_left days ($expires). Rotate it or finish the OIDC switch (ADR-C10, R4)."
                    else
                        echo "Client secret expires on $expires ($days_left days left)."
                    fi
                    EOT
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "Bash"
                OctopusUseBundledTooling = "False"
            }

            container {
                feed = "<docker-hub-feed>"
                image = "octopusdeploy/worker-tools:<worker-tools-version>"
            }
        }
    }
}
