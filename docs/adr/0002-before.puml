@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Before: Manual Work Order Creation for Recurring Tasks

Person(user, "Facilities Manager", "Creates work orders manually")

System_Boundary(ui, "UI Layer") {
    Component(manage, "WorkOrderManage.razor", "Blazor Component", "Work order creation form")
}

System_Boundary(core, "Core Layer") {
    Component(command, "SaveDraftCommand", "MediatR Command", "Creates new work order")
    Component(model, "WorkOrder", "Domain Model", "Properties: Title, Description, Status, AssignedTo")
}

System_Boundary(data, "Data Layer") {
    ComponentDb(db, "SQL Server", "Database", "WorkOrder table")
}

Rel(user, manage, "Manually creates", "Every week/month")
Rel(manage, command, "Sends", "HTTP/MediatR")
Rel(command, model, "Creates")
Rel(model, db, "Persists")

note right of user
  **Problems:**
  - Must remember to create
  - Inconsistent timing
  - Administrative overhead
  - Risk of forgotten tasks
end note

@enduml
