<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>dotnet-Worker-b9b5c0f8-4249-469b-8bfb-c4cc9398b886</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire 17: the Aspire.AppHost.Sdk is obsolete (ASPIRE012). The app host is now an ordinary
         console project that references the hosting packages explicitly. -->
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin transitive MessagePack (from Aspire SDK) above 2.5.192 to resolve NU1902/NU1903.
         2.5.307 is also the floor required by Aspire.Hosting.AppHost 17.0.0. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aspire.Hosting" />
  </ItemGroup>
</Project>
