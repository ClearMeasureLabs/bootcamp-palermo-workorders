{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "McpRateLimiting": {
    "MaxTrackedBuckets": 10000,
    "IdleTimeoutMinutes": 30,
    "Default": {
      "Capacity": 10,
      "RefillTokens": 10,
      "RefillPeriodSeconds": 60
    },
    "Tools": {
      "list-work-orders": {
        "Capacity": 60,
        "RefillTokens": 60,
        "RefillPeriodSeconds": 60
      },
      "get-work-order": {
        "Capacity": 60,
        "RefillTokens": 60,
        "RefillPeriodSeconds": 60
      },
      "list-work-order-attachments": {
        "Capacity": 30,
        "RefillTokens": 30,
        "RefillPeriodSeconds": 60
      },
      "list-employees": {
        "Capacity": 30,
        "RefillTokens": 30,
        "RefillPeriodSeconds": 60
      },
      "get-employee": {
        "Capacity": 30,
        "RefillTokens": 30,
        "RefillPeriodSeconds": 60
      },
      "create-work-order": {
        "Capacity": 5,
        "RefillTokens": 5,
        "RefillPeriodSeconds": 60
      },
      "create-dated-work-orders": {
        "Capacity": 2,
        "RefillTokens": 2,
        "RefillPeriodSeconds": 60
      },
      "save-work-order": {
        "Capacity": 5,
        "RefillTokens": 5,
        "RefillPeriodSeconds": 60
      },
      "execute-work-order-command": {
        "Capacity": 5,
        "RefillTokens": 5,
        "RefillPeriodSeconds": 60
      }
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ConnectionString": ""
  },
  "AI_OpenAI_ApiKey": "",
  "AI_OpenAI_Url": "",
  "AI_OpenAI_Model": "",
  "DISABLE_AUTO_REFORMAT_AGENT": "true",
  "ApiRateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 4,
    "QueueLimit": 0,
    "ApiKeyHeaderName": "X-API-Key"
  },
  "ApiKeyAuthentication": {
    "Enabled": false,
    "ValidationKey": ""
  },
  "FeatureFlags": {
    "SampleFeatureA": false,
    "SampleFeatureB": false
  },
  "Cors": {
    "Enabled": false,
    "AllowedOrigins": []
  },
  "RequestBodyBuffering": {
    "Enabled": true,
    "BufferThreshold": 1048576
  },
  "ApiRequestTimeouts": {
    "Enabled": true,
    "TimeoutSeconds": 120
  }
}
