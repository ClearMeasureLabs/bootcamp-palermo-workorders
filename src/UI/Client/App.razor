@using ClearMeasure.Bootcamp.UI.Shared.Authentication
@using ClearMeasure.Bootcamp.UI.Shared
<ApplicationInsightsInit IsWasmStandalone="true" />
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="new[] {typeof(ClearMeasure.Bootcamp.UI.Shared.MainLayout).Assembly}">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(ClearMeasure.Bootcamp.UI.Shared.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
        </Found>
        @* Router.NotFound is obsolete (CS0618) in favor of NotFoundPage; deliberately retained here.
           Qodana Phase 1 triage (#8321): migrating to NotFoundPage was attempted on this .NET 10
           release and broke standalone WebAssembly boot. Do not migrate until a future .NET
           release fixes that regression; then this comment and the obsolete usage can be removed. *@
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(ClearMeasure.Bootcamp.UI.Shared.MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>