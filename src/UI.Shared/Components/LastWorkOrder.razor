@implements Palermo.BlazorMvc.IListener<WorkOrderChangedEvent>
@implements Palermo.BlazorMvc.IListener<WorkOrderSelectedEvent>
@using ClearMeasure.Bootcamp.UI.Shared.Pages
@inherits AppComponentBase

@if (WorkOrderLastChanged != null)
{
    <a href="/workorder/manage/@(WorkOrderLastChanged?.Number)?mode=Edit"
       title="Most recently viewed work order"
       data-testid="@nameof(Elements.LastWorkOrderTooltip)">
        @WorkOrderLastChanged?.Number
    </a>
}

@code {

    private WorkOrder? WorkOrderLastChanged { get; set; }

    public void Handle(WorkOrderChangedEvent theEvent)
    {
        SetLastWorkOrder(theEvent.Result.WorkOrder);
    }

    public void Handle(WorkOrderSelectedEvent theEvent)
    {
        SetLastWorkOrder(theEvent.CurrentWorkOrder);
    }

    private void SetLastWorkOrder(WorkOrder order)
    {
        WorkOrderLastChanged = order;
        InvokeAsync(StateHasChanged);
    }

    public enum Elements
    {
        LastWorkOrderTooltip
    }

}
