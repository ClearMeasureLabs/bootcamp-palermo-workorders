<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Menu</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill nav-icon" aria-hidden="true"></i>
                <span class="nav-text">Home</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink data-testid="@Elements.Counter" class="nav-link" href="counter">
                <i class="bi bi-calculator-fill nav-icon" aria-hidden="true"></i>
                <span class="nav-text">Counter</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="fetchdata">
                <i class="bi bi-cloud-arrow-down-fill nav-icon" aria-hidden="true"></i>
                <span class="nav-text">Fetch data</span>
            </NavLink>
        </div>
        
        @if (CurrentUser != null)
        {
            <div class="nav-item px-3">
                <NavLink data-testid="@Elements.AiAgent" class="nav-link" href="ai-agent">
                    <i class="bi bi-robot nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">AI Agent</span>
                </NavLink>
            </div>
        }

        @if (CurrentUser != null && CurrentUser.CanCreateWorkRequest())
        {
            <div class="nav-item px-3">
                <NavLink data-testid="@Elements.NewWorkRequest" class="nav-link" href="workrequest/manage?mode=New">
                    <i class="bi bi-file-earmark-plus-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">New Work Request</span>
                </NavLink>
            </div>
        }

        @if (CurrentUser != null)
        {
            <div class="nav-item px-3">
                <NavLink data-testid="@Elements.Search" class="nav-link" href="workrequest/search">
                    <i class="bi bi-search nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Search</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink data-testid="@Elements.Settings" class="nav-link" href="settings">
                    <i class="bi bi-gear-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Settings</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink data-testid="@Elements.MyWorkRequests" class="nav-link" href="@($"workrequest/search?Creator={CurrentUser?.UserName}")">
                    <i class="bi bi-person-badge-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text"><MyWorkRequests/></span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink data-testid="@Elements.WorkRequestsAssignedToMe" class="nav-link" href="@($"workrequest/search?Assignee={CurrentUser?.UserName}")">
                    <i class="bi bi-person-check-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Assigned To Me</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink data-testid="@Elements.AllAssignedWorkRequests" class="nav-link" href="@($"workrequest/search?Status={WorkRequestStatus.Assigned.Key}")">
                    <i class="bi bi-clipboard2-check-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">All Assigned</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink data-testid="@Elements.AllWorkRequestsInProgress" class="nav-link" href="@($"workrequest/search?Status={WorkRequestStatus.InProgress.Key}")">
                    <i class="bi bi-gear-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">In Progress</span>
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <span class="nav-text"><LastWorkRequest/></span>
            </div>
        }
    </nav>
</div>
@code
{
    public enum Elements
    {
        Counter,
        AiAgent,
        MyWorkRequests,
        WorkRequestsAssignedToMe,
        AllAssignedWorkRequests,
        AllWorkRequestsInProgress,
        Search,
        Settings,
        NewWorkRequest,
        LastWorkRequest
    }
}
