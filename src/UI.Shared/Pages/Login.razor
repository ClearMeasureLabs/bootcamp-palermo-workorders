<PageTitle>Login</PageTitle>

<div class="login-container">
    <div class="login-card card">
        <div class="login-header">
            <h3>Welcome to the Church Portal</h3>
            <div class="login-subtitle">First Church of Shelbyville</div>
        </div>
        <div class="login-body">
            <EditForm Model="@LoginModelValue" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator/>
                <ValidationSummary/>

                <h2><i class="bi bi-lock" aria-hidden="true"></i> Sign in</h2>
                <p class="text-muted">Choose your name to continue</p>
                <div class="form-group">
                    <label for="@Elements.User">Select Church Member</label>
                    <InputSelect id="@Elements.User" data-testid="@Elements.User" @bind-Value="LoginModelValue.Username" class="form-control" autofocus>
                        <option value="">-- Select a parishioner or staff member --</option>
                        @foreach (var employee in Employees)
                        {
                            <option value="@employee.UserName">@GetLoginDropdownDisplayName(employee)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => LoginModelValue.Username)"/>
                    <small class="form-text text-muted">Not listed? Ask the church office to add you.</small>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rememberMySelection" data-testid="@Elements.RememberMySelection" />
                    <label class="form-check-label" for="rememberMySelection">Remember my selection</label>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger">@ErrorMessage</div>
                }

                <div>
                    <button data-testid="@Elements.LoginButton" type="submit" class="btn btn-primary w-100" disabled="@(string.IsNullOrEmpty(LoginModelValue.Username))">Enter the Portal</button>
                </div>
            </EditForm>

            <div class="text-center">
                <small><a href="mailto:office@firstchurchofshelbyville.org">Forgot your login?</a></small>
            </div>

            <div class="text-center">
                <small>Or call the office: <a href="tel:+15550102468">(555) 010-2468</a></small>
            </div>

            <div class="text-center lovejoy-shortcut">
                <button type="button"
                        data-testid="@Elements.LovejoyShortcut"
                        class="btn btn-link lovejoy-shortcut-link"
                        @onclick="LoginAsTimothyLovejoy">
                    Log in as Timothy Lovejoy
                </button>
            </div>

            <div class="church-blessing">
                "May your service to the church be blessed and your work orders be few."
            </div>

            <div class="text-center">
                <small class="text-muted">First Church of Shelbyville · @DateTime.Now.Year</small>
                <a href="https://www.clear-measure.com" target="_blank" rel="noopener noreferrer" class="text-muted"><small>Need help?</small></a>
            </div>
            <div class="text-center">
                <small class="text-muted">Version @AppVersion</small>
            </div>
        </div>
    </div>
</div>

@code {

    public enum Elements
    {
        User,
        LoginButton,
        LovejoyShortcut,
        RememberMySelection
    }

}
