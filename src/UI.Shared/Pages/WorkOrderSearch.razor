<div class="search-page">
    <div class="search-container">
        <div class="search-filters-card">
            <EditForm Model="@Model" OnValidSubmit="OnSearch!">
                <div class="filter-chips">
                    <span class="filter-funnel" aria-hidden="true">
                        <i class="bi bi-funnel"></i>
                    </span>
                    <div class="filter-chip">
                        <label class="filter-label" for="@Elements.CreatorSelect">Creator</label>
                        <InputSelect id="@Elements.CreatorSelect" data-testid="@Elements.CreatorSelect" @bind-Value="Model.Filters.Creator" class="form-control">
                            <option value="">All</option>
                            @foreach (var user in UserOptions)
                            {
                                <option value="@user.Value">@user.Text</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="filter-chip">
                        <label class="filter-label" for="@Elements.AssigneeSelect">Assignee</label>
                        <InputSelect id="@Elements.AssigneeSelect" data-testid="@Elements.AssigneeSelect" @bind-Value="Model.Filters.Assignee" class="form-control">
                            <option value="">All</option>
                            @foreach (var user in UserOptions)
                            {
                                <option value="@user.Value">@user.Text</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="filter-chip">
                        <label class="filter-label" for="@Elements.StatusSelect">Status</label>
                        <InputSelect id="@Elements.StatusSelect" data-testid="@Elements.StatusSelect" @bind-Value="Model.Filters.Status" class="form-control">
                            <option value="">All</option>
                            @foreach (var status in StatusOptions)
                            {
                                <option value="@status.Value">@status.Text</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="filter-action">
                        <button id="@Elements.SearchButton" data-testid="@Elements.SearchButton" type="submit" class="btn btn-primary">
                            <i class="bi bi-search" aria-hidden="true"></i> Search
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        <div class="series-prompt" data-testid="SeriesPrompt">
            <span class="series-prompt-label">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <strong>AI</strong>
            </span>
            <span class="series-prompt-text">Schedule Willie to mow every Saturday for ten weeks.</span>
        </div>

        <div class="results-card">
            @if (Model.Results.Length == 0)
            {
                <div class="empty-results">
                    <div class="empty-results-icon">
                        <i class="bi bi-inbox" aria-hidden="true"></i>
                    </div>
                    <p>No work orders found matching your search criteria.</p>
                    <p>Try adjusting your filters or create a new work order.</p>
                </div>
            }
            else
            {
                <div class="rail-shell">
                    <button type="button"
                            class="rail-arrow rail-arrow-previous"
                            data-testid="RailPrevious"
                            aria-label="Show previous work order"
                            disabled="@(SelectedResultIndex == 0)"
                            @onclick="SelectPrevious">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </button>
                    <div class="work-order-rail" data-testid="WorkOrderRail" aria-label="Work order results">
                        @for (var index = 0; index < Model.Results.Length; index++)
                        {
                            var order = Model.Results[index];
                            var isSelected = index == SelectedResultIndex;
                            var cardClass = isSelected ? "work-order-card is-selected" : "work-order-card";
                            var workOrderLinkTestId = Elements.WorkOrderLink + order.Number;
                            <a class="@cardClass"
                               data-testid="@workOrderLinkTestId"
                               data-rail-card
                               data-selected="@isSelected.ToString().ToLowerInvariant()"
                               aria-current="@(isSelected ? "true" : null)"
                               href="/workorder/manage/@order.Number?mode=Edit">
                                <span class="card-calendar" aria-hidden="true">
                                    <i class="bi bi-calendar3"></i>
                                </span>
                                <span class="card-number">@order.Number</span>
                                <span class="card-title">@(order.Title ?? "Untitled work order")</span>
                                <span class="card-assignee">
                                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                                    @(order.Assignee?.GetFullName() ?? "Unassigned")
                                </span>
                                <span class="card-rule"></span>
                                <span data-testid="@(Elements.DueDateCell + order.Number)"
                                      class="card-due-date @order.DueDateCssClass">
                                    @order.DueDateDisplay
                                    @if (!string.IsNullOrEmpty(order.DueDateUrgencyText))
                                        {
                                            <span class="visually-hidden">@order.DueDateUrgencyText</span>
                                    }
                                </span>
                                @if (!string.IsNullOrEmpty(order.DueDateUrgencyText))
                                {
                                    <span class="urgency-label @order.DueDateCssClass" aria-hidden="true">
                                        <i class="bi @(order.DueDateCssClass == "due-date-overdue" ? "bi-exclamation-circle" : "bi-clock")"></i>
                                        @(order.DueDateCssClass == "due-date-overdue" ? "Overdue" : "Due today")
                                    </span>
                                }
                            </a>
                        }
                    </div>
                    <button type="button"
                            class="rail-arrow rail-arrow-next"
                            data-testid="RailNext"
                            aria-label="Show next work order"
                            disabled="@(SelectedResultIndex >= Model.Results.Length - 1)"
                            @onclick="SelectNext">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="rail-position" aria-live="polite">
                    <span class="position-dot is-active"></span>
                    <span>Work order @(SelectedResultIndex + 1) of @Model.Results.Length</span>
                </div>
            }
        </div>
    </div>
</div>

@code {

    public enum Elements
    {
        CreatorSelect,
        AssigneeSelect,
        StatusSelect,
        SearchButton,
        WorkOrderLink,
        DueDateCell
    }

    public WorkOrderSearchModel Model { get; set; } = new();
    public List<SelectListItem> UserOptions { get; set; } = new();
    public List<SelectListItem> StatusOptions { get; set; } = new();
    public Func<Task>? OnSearch { get; set; }

    private int SelectedResultIndex { get; set; }

    private void SelectPrevious()
    {
        SelectedResultIndex = Math.Max(0, SelectedResultIndex - 1);
    }

    private void SelectNext()
    {
        SelectedResultIndex = Math.Min(Model.Results.Length - 1, SelectedResultIndex + 1);
    }
}
