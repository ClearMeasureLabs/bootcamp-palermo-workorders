<div class="search-page">
    <div class="search-container">
        <div class="search-header">
            <h2>My Work Orders</h2>
        </div>

        <div class="search-filters-card">
            <EditForm Model="@Model" OnValidSubmit="OnSearch!">
                <div class="filters-grid">
                    <div class="filter-group">
                        <label class="filter-label" for="@Elements.CreatorSelect">Creator</label>
                        <InputSelect id="@Elements.CreatorSelect" data-testid="@Elements.CreatorSelect" @bind-Value="Model.Filters.Creator" class="form-control">
                            <option value="">All</option>
                            @foreach (var user in UserOptions)
                            {
                                <option value="@user.Value">@user.Text</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label" for="@Elements.AssigneeSelect">Assignee</label>
                        <InputSelect id="@Elements.AssigneeSelect" data-testid="@Elements.AssigneeSelect" @bind-Value="Model.Filters.Assignee" class="form-control">
                            <option value="">All</option>
                            @foreach (var user in UserOptions)
                            {
                                <option value="@user.Value">@user.Text</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label" for="@Elements.StatusSelect">Status</label>
                        <InputSelect id="@Elements.StatusSelect" data-testid="@Elements.StatusSelect" @bind-Value="Model.Filters.Status" class="form-control">
                            <option value="">All</option>
                            @foreach (var status in StatusOptions)
                            {
                                <option value="@status.Value">@status.Text</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="filter-group">
                        <button id="@Elements.SearchButton" data-testid="@Elements.SearchButton" type="submit" class="btn btn-primary">
                            <i class="bi bi-search" aria-hidden="true"></i> Search
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        <section class="results-card" aria-labelledby="search-results-heading">
            <h3 id="search-results-heading" class="visually-hidden">Search Results</h3>

            @if (Model.Results.Length == 0)
            {
                <div class="empty-results">
                    <div class="empty-results-icon">
                        <i class="bi bi-inbox" aria-hidden="true"></i>
                    </div>
                    <p>No work orders found matching your search criteria.</p>
                    <p>Try adjusting your filters or create a new work order.</p>
                </div>
            }
            else
            {
                <div class="work-order-stack" data-testid="WorkOrderStack">
                    @foreach (var order in Model.Results)
                    {
                        var workOrderLinkTestId = Elements.WorkOrderLink + order.Number;
                        var workOrderCardTestId = Elements.WorkOrderCard + order.Number;
                        var isSelected = SelectedWorkOrderNumber == order.Number;
                        <article class="work-order-card @(isSelected ? "selected" : null)"
                                 data-testid="@workOrderCardTestId"
                                 aria-selected="@(isSelected ? "true" : "false")"
                                 @onclick="() => SelectedWorkOrderNumber = order.Number">
                            <div class="card-accent" aria-hidden="true"></div>
                            <div class="card-main">
                                <div class="card-heading">
                                    <div>
                                        <span class="work-order-number visually-hidden">@order.Number</span>
                                        <h4>@order.Title</h4>
                                    </div>
                                    <span class="status-badge visually-hidden">@order.Status</span>
                                </div>
                                <div class="card-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @DisplayAssignee(order)</span>
                                </div>
                            </div>
                            <span data-testid="@(Elements.DueDateCell + order.Number)"
                                  class="due-pill @order.DueDateCssClass">@if (!string.IsNullOrEmpty(order.DueDateDisplay))
                            {<span class="due-label">Due</span> @order.DueDateDisplay
                                @if (!string.IsNullOrEmpty(order.DueDateUrgencyText))
                                {
                                    <span class="visually-hidden">@order.DueDateUrgencyText</span>
                                }
                            }</span>
                            <a class="manage-link"
                               data-testid="@workOrderLinkTestId"
                               href="/workorder/manage/@order.Number?mode=Edit"
                               aria-label="Manage work order @order.Number">
                                <span class="visually-hidden">@order.Number</span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {

    public enum Elements
    {
        CreatorSelect,
        AssigneeSelect,
        StatusSelect,
        SearchButton,
        WorkOrderLink,
        DueDateCell,
        WorkOrderCard
    }

    public WorkOrderSearchModel Model { get; set; } = new();
    public List<SelectListItem> UserOptions { get; set; } = new();
    public List<SelectListItem> StatusOptions { get; set; } = new();
    public Func<Task>? OnSearch { get; set; }
    private string? SelectedWorkOrderNumber { get; set; }

    private static string DisplayAssignee(WorkOrderSearchResultRow order)
    {
        return order.Assignee?.GetFullName() ?? "Unassigned";
    }
}
