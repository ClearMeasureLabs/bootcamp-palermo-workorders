<div class="search-page" data-testid="@Elements.B1DeckPage">
    <div class="search-container">
        <div class="search-header">
            <h2>Church<br />Work Orders</h2>
            <div class="search-cross" aria-hidden="true">†</div>
        </div>

        @if (ShowSeriesChrome)
        {
            <div class="series-prompt" data-testid="@Elements.SeriesPrompt">
                <span class="series-prompt-icon" aria-hidden="true">
                    <i class="bi bi-stars"></i>
                </span>
                <span class="series-prompt-text">@SeriesPrompt</span>
                <span class="series-count-badge" data-testid="@Elements.SeriesCountBadge">@Model.Results.Length</span>
            </div>
        }

        <div class="search-filters-strip">
            <span class="filter-by-label">Filter by:</span>
            <EditForm Model="@Model" OnValidSubmit="OnSearch!" class="filters-chip-form">
                <div class="filters-chip-strip">
                    <div class="filter-chip">
                        <label class="filter-label" for="@Elements.CreatorSelect">Creator</label>
                        <InputSelect id="@Elements.CreatorSelect" @bind-Value="Model.Filters.Creator" class="form-control filter-select">
                            <option value="">All</option>
                            @foreach (var user in UserOptions)
                            {
                                <option value="@user.Value">@user.Text</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="filter-chip">
                        <label class="filter-label" for="@Elements.AssigneeSelect">Assignee</label>
                        <InputSelect id="@Elements.AssigneeSelect" @bind-Value="Model.Filters.Assignee" class="form-control filter-select">
                            <option value="">All</option>
                            @foreach (var user in UserOptions)
                            {
                                <option value="@user.Value">@user.Text</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="filter-chip">
                        <label class="filter-label" for="@Elements.StatusSelect">Status</label>
                        <InputSelect id="@Elements.StatusSelect" @bind-Value="Model.Filters.Status" class="form-control filter-select">
                            <option value="">All</option>
                            @foreach (var status in StatusOptions)
                            {
                                <option value="@status.Value">@status.Text</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="filter-chip filter-chip-action">
                        <button id="@Elements.SearchButton" type="submit" class="btn btn-primary">
                            <i class="bi bi-search" aria-hidden="true"></i> Search
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        <div class="deck-stage" data-testid="@Elements.ResultsDeck">
            @if (Model.Results.Length == 0)
            {
                <div class="empty-results">
                    <div class="empty-results-icon">
                        <i class="bi bi-inbox" aria-hidden="true"></i>
                    </div>
                    <p>No work orders found matching your search criteria.</p>
                    <p>Try adjusting your filters or create a new work order.</p>
                </div>
            }
            else
            {
                <div class="saturday-deck" style="--deck-count: @Model.Results.Length">
                    @{
                        var isSeries = IsSaturdaySeries;
                        var count = Model.Results.Length;
                        for (var i = 0; i < count; i++)
                        {
                            var order = Model.Results[i];
                            var fanOffset = count == 1 ? 0 : (i - (count - 1) / 2.0);
                            var rotate = fanOffset * 3.2;
                            var translateX = fanOffset * 42;
                            var z = i + 1;
                            var dateLabel = SaturdaySeriesDeck.CardDateLabel(order, i, isSeries);
                            var workOrderLinkTestId = Elements.WorkOrderLink + order.Number;
                            <a data-testid="@workOrderLinkTestId"
                               class="deck-card"
                               href="/workorder/manage/@order.Number?mode=Edit"
                               style="--fan-rotate: @(rotate.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))deg; --fan-x: @(translateX.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))px; --fan-z: @z;">
                                <span class="deck-card-date">@dateLabel</span>
                                <span class="deck-card-icon" aria-hidden="true">
                                    <i class="bi bi-tools"></i>
                                </span>
                                <span class="deck-card-title">@order.Title</span>
                                <span class="deck-card-assignee">
                                    @(order.Assignee is null ? "Unassigned" : $"Assigned to {order.Assignee.GetFullName()}")
                                </span>
                                <span class="deck-card-status">@order.Status</span>
                                <span data-testid="@(Elements.DueDateCell + order.Number)" class="deck-card-due @order.DueDateCssClass">
                                    @if (!string.IsNullOrEmpty(order.DueDateUrgencyText))
                                    {
                                        @order.DueDateUrgencyText
                                    }
                                    else if (!string.IsNullOrEmpty(order.DueDateDisplay))
                                    {
                                        @order.DueDateDisplay
                                    }
                                </span>
                            </a>
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {

    public enum Elements
    {
        CreatorSelect,
        AssigneeSelect,
        StatusSelect,
        SearchButton,
        WorkOrderLink,
        DueDateCell,
        B1DeckPage,
        ResultsDeck,
        SeriesPrompt,
        SeriesCountBadge
    }

    public WorkOrderSearchModel Model { get; set; } = new();
    public List<SelectListItem> UserOptions { get; set; } = new();
    public List<SelectListItem> StatusOptions { get; set; } = new();
    public Func<Task>? OnSearch { get; set; }

    private bool IsSaturdaySeries => SaturdaySeriesDeck.IsSaturdaySeries(Model.Results);

    private bool ShowSeriesChrome => IsSaturdaySeries;

    private string SeriesPrompt => SaturdaySeriesDeck.SeriesPromptText(Model.Results);
}
