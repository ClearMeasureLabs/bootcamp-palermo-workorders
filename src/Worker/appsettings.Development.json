{
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.StaticFiles": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Mvc": "Warning",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.StaticFiles": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "[yyyy-MM-dd HH:mm:ss] ",
        "IncludeScopes": true
      }
    }
  },
  "RemotableBus": {
    "ApiUrl": "https://localhost:7174/api/blazor-wasm-single-api"
  },
  "ConnectionStrings": {
    "SqlConnectionString": "server=(LocalDb)\\MSSQLLocalDB;database=ChurchBulletin;Integrated Security=true;TrustServerCertificate=true;",
    "AppInsights": "",
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "LocalTelemetry": {
    "Enabled": true,
    "LogDirectory": "logs"
  }
}
