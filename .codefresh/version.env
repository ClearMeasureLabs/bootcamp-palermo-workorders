# Version prefix for artifacts built by Codefresh for the new delivery platform (ADR-C7).
# Read, never sourced, by .codefresh/scripts/version.sh. The patch number is the
# first-parent commit height of master, so every master commit maps to one version.
# The legacy GitHub Actions path keeps 2.4.<run> in its own Octopus space until it retires.
# Bump MINOR (not MAJOR) before the height reaches 65534 (AssemblyVersion part limit).
MAJOR=2
MINOR=5
