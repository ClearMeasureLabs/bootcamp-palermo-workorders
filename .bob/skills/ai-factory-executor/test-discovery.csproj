<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AiFactoryDiscovery</RootNamespace>
    <AssemblyName>test-discovery</AssemblyName>
    
    <!-- Single-file publish settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    
    <!-- Version info -->
    <Version>1.0.0</Version>
    <Authors>ClearMeasure Labs</Authors>
    <Description>AI Factory Discovery Test</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude executor.cs from this project -->
    <Compile Remove="executor.cs" />
  </ItemGroup>

</Project>
